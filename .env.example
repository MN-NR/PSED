# Template for the API keys the experiments need. Copy this to `third_party/SED/.env`
# (the drivers load keys from there) and fill in real values. NEVER commit a real .env —
# it is gitignored. The same keys also work if you additionally place them at the repo root.
#
#   cp .env.example third_party/SED/.env   # then edit in your keys

# Fireworks: serves the protected agent (Nemotron, gpt-oss) AND SED's judge / policy
# synthesizer / broadness-check gate / embeddings. Required for all primary experiments.
FIREWORKS_API_KEY=fw_your_key_here

# OpenRouter: only needed for the cross-family screens/runs that route the AGENT to OpenRouter
# (e.g. the Meta/Mistral susceptibility screens). Leave blank if you only run Fireworks models.
OPENROUTER_API_KEY=sk-or-v1-your_key_here
